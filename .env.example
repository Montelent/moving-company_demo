# Sanity project credentials
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: for write operations / webhooks
# SANITY_API_TOKEN=your-token

# Mobile-friendly editor (/mobile-admin)
# Use a long, unique password and a random secret (at least 32 characters).
MOBILE_ADMIN_PASSWORD=replace-with-a-long-unique-password
MOBILE_ADMIN_SESSION_SECRET=replace-with-a-random-secret
# Create a Sanity API token with Editor permissions; keep it server-side only.
SANITY_API_TOKEN=your-sanity-write-token
